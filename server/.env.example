DATABASE_URL=postgres://localhost:5432/meat_erp
PORT=3001
# Shared passcode for the web app and the station agent. Leave empty only for local dev.
APP_PASSCODE=
# Public URL of this server, used for the QuickBooks OAuth redirect
PUBLIC_URL=http://localhost:3001
# QuickBooks Online app (developer.intuit.com → your app → Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# After manifest: also create a QuickBooks invoice from the updated estimate
QBO_CREATE_INVOICE=false
